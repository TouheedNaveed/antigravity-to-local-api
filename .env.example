# AGY Local API configuration
# Copy this file to .env and adjust only what you need.

# Keep the API local to this Mac by default. Do not use 0.0.0.0 without securing access.
HOST=127.0.0.1
PORT=8788

# Leave blank to use ~/.local/bin/agy. Set an absolute path only if AGY is elsewhere.
AGY_BIN=

# Optional: leave blank to disable API-key auth (localhost-only use).
# Set a long random secret before exposing the API beyond this machine.
AGY_API_KEY=


# Leave blank to store memory under this project's ./memory directory.
AGY_MEMORY_DIR=

# Request limits (milliseconds where noted)
AGY_TIMEOUT_MS=300000
AGY_STARTUP_TIMEOUT_MS=45000
AGY_QUEUE_TIMEOUT_MS=120000
AGY_MAX_CONCURRENT=4
AGY_MAX_QUEUE=32
AGY_RETRIES=1
AGY_SHUTDOWN_GRACE_MS=10000

# Worker pool: ready-to-use AGY processes kept per model (single use, fresh conversation each request)
AGY_PREWARM=1
# Each idle AGY process holds about 240 MB of RAM, so cap the total number of standby processes
AGY_PREWARM_MAX=2
AGY_STANDBY_IDLE_MS=120000
# Client-bound sessions (requests that send session_id / conversation_id)
AGY_MAX_SESSION_WORKERS=4
AGY_SESSION_IDLE_MS=300000

# 1 = run AGY in a bridge-only HOME with a tool-less minimal agent (about 450 prompt tokens per request instead of about 12k with your global AGY config).
# 0 = legacy behaviour: use your global AGY config, skills and MCP servers.
AGY_ISOLATE=1
# 1 = the bridge agent sets excludeDefaultComponents, dropping AGY's built-in system prompt and tools (about 450 instead of 2,050 prompt tokens for "Say OK").
# Ignored while AGY_MEMORY_TOOLS=on. 0 = keep AGY's default prompt.
AGY_MINIMAL_AGENT=1
# 1 = shorter wrapper text around the conversation, function definitions and JSON mode (about 15 to 100 fewer tokens).
AGY_COMPACT_PROMPT=1
# Optional history cap for requests that carry a long conversation. Oldest turns are dropped first; system messages and the last message are always kept. 0 = no cap.
AGY_MAX_HISTORY_TOKENS=0
AGY_MAX_HISTORY_MESSAGES=0
# Leave blank for ./.agy-home
AGY_HOME_DIR=
AGY_HOME_RETAIN_HOURS=12
# off = no memory MCP and no MEMORY TOOL POLICY text in the prompt. on = give AGY the agy-memory MCP tools.
AGY_MEMORY_TOOLS=off

# API keys: with 1 (default) every /v1/* call needs a valid key made in the dashboard (http://127.0.0.1:PORT/).
# 0 = the API is open only while no keys exist and AGY_API_KEY is empty.
AGY_REQUIRE_KEY=1
# Where keys.json and admin.json live (blank = ./data)
AGY_DATA_DIR=
# Extra Host header names allowed for the dashboard (comma separated). Loopback names are always allowed.
AGY_ADMIN_ALLOWED_HOSTS=

# How often (ms) the dashboard asks `agy /usage` for plan quota while a dashboard tab is open. 0 = never.
AGY_QUOTA_POLL_MS=120000

# Max request body size in MB (long chat histories from coding agents can be large)
AGY_MAX_BODY_MB=64
